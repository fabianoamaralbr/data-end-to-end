{
  "name": "ls_http_kaggle",
  "type": "Microsoft.DataFactory/factories/linkedservices",
  "properties": {
    "type": "HttpServer",
    "description": "Endpoint HTTP do dataset publico do Kaggle (usado para carga inicial; em producao o ls_adls_gen2 e usado apos o upload via download_kaggle_data.py)",
    "typeProperties": {
      "url": "https://www.kaggle.com/api/v1/",
      "enableServerCertificateValidation": true,
      "authenticationType": "Basic",
      "userName": {
        "type": "AzureKeyVaultSecret",
        "store": {
          "referenceName": "ls_key_vault",
          "type": "LinkedServiceReference"
        },
        "secretName": "kaggle-username"
      },
      "password": {
        "type": "AzureKeyVaultSecret",
        "store": {
          "referenceName": "ls_key_vault",
          "type": "LinkedServiceReference"
        },
        "secretName": "kaggle-api-key"
      }
    },
    "annotations": ["kaggle", "financial-data", "source"]
  }
}
