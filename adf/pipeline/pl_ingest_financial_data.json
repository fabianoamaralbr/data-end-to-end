{
  "name": "pl_ingest_financial_data",
  "type": "Microsoft.DataFactory/factories/pipelines",
  "properties": {
    "description": "Ingere dados financeiros OHLCV do Kaggle (via HTTP) no container raw do ADLS e em seguida dispara o workflow medallion no Databricks.",
    "parameters": {
      "storageAccountName": {
        "type": "string",
        "defaultValue": "stfinancialdata"
      },
      "targetFileName": {
        "type": "string",
        "defaultValue": "financial_data.csv"
      },
      "databricksJobId": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "CopyKaggleToRaw",
        "type": "Copy",
        "description": "Faz download do CSV da API do Kaggle e deposita no container raw do ADLS.",
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "HttpReadSettings",
              "requestMethod": "GET"
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            }
          },
          "sink": {
            "type": "DelimitedTextSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "DelimitedTextWriteSettings",
              "quoteAllText": false,
              "fileExtension": ".csv"
            }
          },
          "enableStaging": false,
          "translator": {
            "type": "TabularTranslator",
            "typeConversion": true,
            "typeConversionSettings": {
              "allowDataTruncation": true,
              "treatBooleanAsNumber": false
            }
          }
        },
        "inputs": [
          {
            "referenceName": "ds_http_kaggle_csv",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_adls_raw_csv",
            "type": "DatasetReference",
            "parameters": {
              "storageAccountName": {
                "value": "@pipeline().parameters.storageAccountName",
                "type": "Expression"
              },
              "fileName": {
                "value": "@pipeline().parameters.targetFileName",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "TriggerMedallionPipeline",
        "type": "DatabricksSparkPython",
        "description": "Dispara o workflow medallion do Databricks (bronze -> silver -> gold) apos a chegada dos dados brutos.",
        "dependsOn": [
          {
            "activity": "CopyKaggleToRaw",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "typeProperties": {
          "pythonFile": "dbfs:/notebooks/01_raw_to_bronze.py",
          "parameters": [
            "--storage-account",
            {
              "value": "@pipeline().parameters.storageAccountName",
              "type": "Expression"
            },
            "--source-file",
            {
              "value": "@pipeline().parameters.targetFileName",
              "type": "Expression"
            }
          ]
        },
        "linkedServiceName": {
          "referenceName": "ls_databricks",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "LogIngestionMetadata",
        "type": "SetVariable",
        "description": "Armazena o timestamp de execucao da ingestao para rastreabilidade.",
        "dependsOn": [
          {
            "activity": "TriggerMedallionPipeline",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "typeProperties": {
          "variableName": "ingestionTimestamp",
          "value": {
            "value": "@utcnow()",
            "type": "Expression"
          }
        }
      }
    ],
    "variables": {
      "ingestionTimestamp": {
        "type": "String"
      }
    },
    "annotations": ["financial-data", "ingestion", "medallion"],
    "concurrency": 1,
    "policy": {
      "elapsedTimeMetric": {}
    }
  }
}
