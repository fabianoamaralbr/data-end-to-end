{
  "name": "pl_ingest_financial_data",
  "type": "Microsoft.DataFactory/factories/pipelines",
  "properties": {
    "description": "Carga historica (backfill) do dataset OHLCV do Kaggle no container raw do ADLS. Fonte estatica: a carga incremental diaria vem de pl_ingest_bcb_sgs. A chegada do arquivo dispara o job Databricks (file arrival trigger) — o ADF nao chama o Databricks diretamente.",
    "parameters": {
      "storageAccountName": {
        "type": "string",
        "defaultValue": "stfinancialdata"
      },
      "targetFileName": {
        "type": "string",
        "defaultValue": "financial_data.csv"
      }
    },
    "activities": [
      {
        "name": "CopyKaggleToRaw",
        "type": "Copy",
        "description": "Faz download do CSV da API do Kaggle e deposita no container raw do ADLS.",
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "HttpReadSettings",
              "requestMethod": "GET"
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            }
          },
          "sink": {
            "type": "DelimitedTextSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "DelimitedTextWriteSettings",
              "quoteAllText": false,
              "fileExtension": ".csv"
            }
          },
          "enableStaging": false,
          "translator": {
            "type": "TabularTranslator",
            "typeConversion": true,
            "typeConversionSettings": {
              "allowDataTruncation": true,
              "treatBooleanAsNumber": false
            }
          }
        },
        "inputs": [
          {
            "referenceName": "ds_http_kaggle_csv",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_adls_raw_csv",
            "type": "DatasetReference",
            "parameters": {
              "storageAccountName": {
                "value": "@pipeline().parameters.storageAccountName",
                "type": "Expression"
              },
              "fileName": {
                "value": "@pipeline().parameters.targetFileName",
                "type": "Expression"
              }
            }
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 120
        }
      }
    ],
    "annotations": [
      "financial-data",
      "ingestion",
      "backfill"
    ],
    "concurrency": 1,
    "policy": {
      "elapsedTimeMetric": {}
    }
  }
}
