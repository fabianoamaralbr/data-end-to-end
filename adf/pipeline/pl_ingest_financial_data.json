{
  "name": "pl_ingest_financial_data",
  "type": "Microsoft.DataFactory/factories/pipelines",
  "properties": {
    "description": "Carga historica (backfill) do dataset OHLCV do Kaggle no container raw do ADLS. Fonte estatica: a carga incremental diaria vem de pl_ingest_bcb_sgs. A chegada do arquivo dispara o job Databricks (file arrival trigger) — o ADF nao chama o Databricks diretamente.",
    "parameters": {
      "storageAccountName": {
        "type": "string",
        "defaultValue": "stfinancialdatadev"
      },
      "kaggleDataset": {
        "type": "string",
        "defaultValue": "adhoppin/financial-data"
      },
      "targetFolder": {
        "type": "string",
        "defaultValue": "financial-data"
      }
    },
    "activities": [
      {
        "name": "CopyKaggleToRaw",
        "type": "Copy",
        "description": "Baixa o ZIP do dataset pela API do Kaggle (Basic auth via Key Vault), descompacta em transito e grava os CSVs com os nomes originais em raw/<targetFolder>/. Reexecutar sobrescreve os mesmos arquivos; a chave de ingestao da bronze evita duplicidade.",
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "HttpReadSettings",
              "requestMethod": "GET"
            },
            "formatSettings": {
              "type": "BinaryReadSettings",
              "compressionProperties": {
                "type": "ZipDeflateReadSettings",
                "preserveZipFileNameAsFolder": false
              }
            }
          },
          "sink": {
            "type": "BinarySink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "ds_http_kaggle_zip",
            "type": "DatasetReference",
            "parameters": {
              "datasetRef": {
                "value": "@pipeline().parameters.kaggleDataset",
                "type": "Expression"
              }
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_adls_raw_binary",
            "type": "DatasetReference",
            "parameters": {
              "storageAccountName": {
                "value": "@pipeline().parameters.storageAccountName",
                "type": "Expression"
              },
              "folderPath": {
                "value": "@pipeline().parameters.targetFolder",
                "type": "Expression"
              },
              "fileName": ""
            }
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 120
        }
      }
    ],
    "annotations": [
      "financial-data",
      "ingestion",
      "backfill"
    ],
    "concurrency": 1,
    "policy": {
      "elapsedTimeMetric": {}
    }
  }
}
