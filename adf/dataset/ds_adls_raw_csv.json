{
  "name": "ds_adls_raw_csv",
  "type": "Microsoft.DataFactory/factories/datasets",
  "properties": {
    "type": "DelimitedText",
    "description": "Sink: raw CSV files landing in ADLS raw container under /financial-data/",
    "linkedServiceName": {
      "referenceName": "ls_adls_gen2",
      "type": "LinkedServiceReference",
      "parameters": {
        "storageAccountName": {
          "value": "@dataset().storageAccountName",
          "type": "Expression"
        }
      }
    },
    "parameters": {
      "storageAccountName": {
        "type": "string"
      },
      "fileName": {
        "type": "string",
        "defaultValue": "financial_data.csv"
      }
    },
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "raw",
        "folderPath": "financial-data",
        "fileName": {
          "value": "@dataset().fileName",
          "type": "Expression"
        }
      },
      "columnDelimiter": ",",
      "escapeChar": "\\",
      "firstRowAsHeader": true,
      "quoteChar": "\""
    },
    "annotations": ["raw", "sink", "csv"]
  }
}
