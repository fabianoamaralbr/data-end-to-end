# ── Azure Subscription ───────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Sem client secret: scripts locais usam DefaultAzureCredential (az login) e o CI usa OIDC.

# ── Azure Resources ───────────────────────────────────────────────────────────
AZURE_RESOURCE_GROUP=rg-financial-data
AZURE_LOCATION=eastus2

# ── Azure Data Lake Storage Gen2 ─────────────────────────────────────────────
ADLS_ACCOUNT_NAME=stfinancialdata
# Sem account key: ADF, Databricks (access connector) e Synapse usam managed identity.
ADLS_CONTAINER_RAW=raw
ADLS_CONTAINER_BRONZE=bronze
ADLS_CONTAINER_SILVER=silver
ADLS_CONTAINER_GOLD=gold

# ── Azure Data Factory ────────────────────────────────────────────────────────
ADF_NAME=adf-financial-data
ADF_RESOURCE_GROUP=rg-financial-data

# ── Azure Databricks ─────────────────────────────────────────────────────────
# Autenticacao do CLI via OAuth: `databricks auth login --host $DATABRICKS_HOST` (sem PAT).
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
UC_CATALOG=financial
ALERT_EMAIL=alertas@example.com

# ── Azure Synapse Analytics ───────────────────────────────────────────────────
SYNAPSE_WORKSPACE_NAME=synw-financial-data
SYNAPSE_SQL_ENDPOINT=synw-financial-data-ondemand.sql.azuresynapse.net

# ── Kaggle ────────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
KAGGLE_DATASET=adhoppin/financial-data
