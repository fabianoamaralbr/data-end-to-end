{
  "name": "financial_data_medallion_pipeline",
  "description": "End-to-end medallion pipeline: raw CSV -> bronze -> silver -> gold Delta Lake tables",
  "email_notifications": {
    "on_failure": ["data-team@your-org.com"],
    "no_alert_for_skipped_runs": false
  },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "setup_mounts",
      "description": "Mount ADLS containers (raw/bronze/silver/gold) to DBFS",
      "notebook_task": {
        "notebook_path": "/Repos/financial-data/databricks/notebooks/00_setup_mounts",
        "source": "GIT",
        "base_parameters": {
          "storage_account": "{{storage_account}}"
        }
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 300
    },
    {
      "task_key": "raw_to_bronze",
      "description": "Ingest raw CSV into Delta Lake bronze layer with metadata columns",
      "depends_on": [
        {"task_key": "setup_mounts"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/financial-data/databricks/notebooks/01_raw_to_bronze",
        "source": "GIT"
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "bronze_to_silver",
      "description": "Cleanse, validate, and enrich bronze data into silver Delta layer",
      "depends_on": [
        {"task_key": "raw_to_bronze"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/financial-data/databricks/notebooks/02_bronze_to_silver",
        "source": "GIT"
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "silver_to_gold",
      "description": "Compute moving averages, lag returns, and daily summaries into gold Delta layer",
      "depends_on": [
        {"task_key": "bronze_to_silver"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/financial-data/databricks/notebooks/03_silver_to_gold",
        "source": "GIT"
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 1800
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "medallion_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2,
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true",
          "spark.sql.extensions": "io.delta.sql.DeltaSparkSessionExtension",
          "spark.sql.catalog.spark_catalog": "org.apache.spark.sql.delta.catalog.DeltaCatalog"
        },
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE",
          "first_on_demand": 1
        },
        "init_scripts": [],
        "autotermination_minutes": 30
      }
    }
  ],
  "git_source": {
    "git_url": "https://github.com/your-org/data-end-to-end",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "America/Sao_Paulo",
    "pause_status": "UNPAUSED"
  },
  "tags": {
    "project": "financial-data",
    "layer": "medallion",
    "team": "data-engineering"
  }
}
