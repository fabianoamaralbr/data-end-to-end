{
  "name": "financial_data_medallion_pipeline",
  "description": "Pipeline medallion incremental (Auto Loader + MERGE) em tabelas externas do Unity Catalog. Disparado pela chegada de arquivos no container raw. Placeholders ${...} sao preenchidos por `make deploy-job`.",
  "email_notifications": {
    "on_failure": ["${ALERT_EMAIL}"],
    "no_alert_for_skipped_runs": true
  },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "parameters": [
    {"name": "catalog", "default": "${UC_CATALOG}"},
    {"name": "storage_account", "default": "${ADLS_ACCOUNT_NAME}"},
    {"name": "max_quarantine_rate", "default": "0.05"}
  ],
  "trigger": {
    "pause_status": "UNPAUSED",
    "file_arrival": {
      "url": "abfss://raw@${ADLS_ACCOUNT_NAME}.dfs.core.windows.net/",
      "min_time_between_triggers_seconds": 900,
      "wait_after_last_change_seconds": 300
    }
  },
  "tasks": [
    {
      "task_key": "setup_unity_catalog",
      "description": "Cria/valida as tabelas externas a partir dos contratos (falha em schema drift)",
      "notebook_task": {
        "notebook_path": "databricks/notebooks/00_setup_unity_catalog",
        "source": "GIT"
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 600
    },
    {
      "task_key": "bronze_ohlcv",
      "depends_on": [{"task_key": "setup_unity_catalog"}],
      "notebook_task": {
        "notebook_path": "databricks/notebooks/01_raw_to_bronze",
        "source": "GIT",
        "base_parameters": {"dataset": "ohlcv", "run_id": "{{job.run_id}}"}
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "bronze_bcb_sgs",
      "depends_on": [{"task_key": "setup_unity_catalog"}],
      "notebook_task": {
        "notebook_path": "databricks/notebooks/01_raw_to_bronze",
        "source": "GIT",
        "base_parameters": {"dataset": "bcb_sgs", "run_id": "{{job.run_id}}"}
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "silver_ohlcv",
      "depends_on": [{"task_key": "bronze_ohlcv"}],
      "notebook_task": {
        "notebook_path": "databricks/notebooks/02_bronze_to_silver",
        "source": "GIT",
        "base_parameters": {"dataset": "ohlcv", "run_id": "{{job.run_id}}"}
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "silver_bcb_sgs",
      "depends_on": [{"task_key": "bronze_bcb_sgs"}],
      "notebook_task": {
        "notebook_path": "databricks/notebooks/02_bronze_to_silver",
        "source": "GIT",
        "base_parameters": {"dataset": "bcb_sgs", "run_id": "{{job.run_id}}"}
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "gold_ohlcv",
      "depends_on": [{"task_key": "silver_ohlcv"}],
      "notebook_task": {
        "notebook_path": "databricks/notebooks/03_silver_to_gold",
        "source": "GIT"
      },
      "job_cluster_key": "medallion_cluster",
      "timeout_seconds": 1800
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "medallion_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER",
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE",
          "first_on_demand": 1
        }
      }
    }
  ],
  "git_source": {
    "git_url": "https://github.com/fabianoamaralbr/data-end-to-end",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tags": {
    "project": "financial-data",
    "layer": "medallion",
    "team": "data-engineering"
  }
}
